
{
  "serverInfo": {
    "name": "Nuvepro MCP Server",
    "version": "1.0.0"
  },
  "authentication": {
    "required": true,
    "schemes": ["oauth2"]
  },
  "tools": [
    {
      "name": "createLab",
      "description": "Creates a lab environment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the lab"
          }
        },
        "required": ["name"]
      }
    },
    {
      "name": "deleteLab",
      "description": "Deletes a lab environment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "labId": {
            "type": "string",
            "description": "Lab ID"
          }
        },
        "required": ["labId"]
      }
    }
  ],
  "resources": [],
  "prompts": []
}
